NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

GEMINI_API_KEY=
# OAuth Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Use the Instagram App ID/secret from Meta's Instagram API with Instagram Login setup.
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/callback/instagram
NEXT_PUBLIC_FACEBOOK_APP_ID=
META_APP_SECRET=

# Video Rendering API & Cloud Video Processing Worker
HUGGINGFACE_WORKER_URL=https://your-space-name.hf.space
FAL_KEY=
HF_ACCESS_TOKEN=
PIXAZO_API_KEY=
POLLINATIONS_API_KEY=

# Cloudinary clip storage. Keep these server-side in .env; never use NEXT_PUBLIC_ for the API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Default matches Cloudinary free upload cap. Increase only if your plan allows larger videos.
CLOUDINARY_MAX_UPLOAD_BYTES=104857600
CLOUDINARY_DELETE_AFTER_PUBLISH=false
# local = process in this Next.js server, cloud = GitHub Actions, queue = desktop worker.
# Defaults to local on localhost and cloud in production.
VIRAL_CLIPS_PROCESSOR=local

# At least one video renderer is required. Rendering may consume paid credits.
SHOTSTACK_API_KEY=
JSON2VIDEO_API_KEY=

# Inngest's Vercel integration supplies the event/signing keys in Vercel.
# Needed locally only if sending events to Inngest Cloud instead of the dev server.
INNGEST_EVENT_KEY=
# Needed by the cloud generation-status endpoint in production.
INNGEST_SIGNING_KEY=
